From: Arkael-Dev <noreply@github.com>
Subject: [PATCH] sched: BORE 5.3.0 backport (KABI-safe, via Arkael-Dev)

Sumber: branch bore-bbrv3-5.10 repo Arkael-Dev/arkael-kernel-a12-5.10,
tiga commit 9caf5f8d63 (import 5.1.0) + 4de13e2b02 (partial 5.1.11) +
49c32850b1 (partial 5.3.0). Pohon Arkael = android12-5.10 Linux 5.10.274,
sama dengan fork ini.

BAGIAN PENTING (penyebab softbrick pada percobaan sebelumnya):
field BORE di struct sched_entity diletakkan di slot KABI, bukan sebagai
field biasa:

    ANDROID_KABI_USE(1, u64 burst_time);
    _ANDROID_KABI_REPLACE(_ANDROID_KABI_RESERVE(2), struct { 4x u8 });
    ANDROID_KABI_USE2(3, u8 child_burst, u32 child_burst_cnt);
    ANDROID_KABI_USE(4, u64 child_burst_last_cached);

Versi port manual sebelumnya memakai field biasa di luar KABI, sehingga
sizeof(struct sched_entity) berubah dan vendor module prebuilt jadi tidak
valid -> kernel berhenti setelah flash.

--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -494,10 +494,24 @@
 	struct sched_avg		avg;
 #endif
 
+#ifdef CONFIG_SCHED_BORE
+	ANDROID_KABI_USE(1, u64 burst_time);
+	_ANDROID_KABI_REPLACE(_ANDROID_KABI_RESERVE(2),
+		struct {
+			u8 prev_burst_penalty;
+			u8 curr_burst_penalty;
+			u8 burst_penalty;
+			u8 burst_score;
+		}
+	);
+	ANDROID_KABI_USE2(3, u8 child_burst, u32 child_burst_cnt);
+	ANDROID_KABI_USE(4, u64 child_burst_last_cached);
+#else // CONFIG_SCHED_BORE
 	ANDROID_KABI_RESERVE(1);
 	ANDROID_KABI_RESERVE(2);
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
+#endif // CONFIG_SCHED_BORE
 };
 
