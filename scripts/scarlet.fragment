# scarlet.fragment — config fragment Scarlet
# Digabung lewat scripts/kconfig/merge_config.sh setelah `make gki_defconfig`,
# lalu `make olddefconfig`. Simbol LTO sudah diverifikasi ada di arch/Kconfig
# pada commit base b1f875995dfb. Simbol KSU_SUSFS_* diambil dari hunk Kconfig
# di 10_susfs.patch (satu-satunya tempat daftar resminya).

## KernelSU-Next: built-in, bukan LKM (PRD 6.2)
CONFIG_KSU=y

## SUSFS built-in (PRD 6.3) — daftar dari Kconfig hasil patch, bukan dari ingatan
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y

## NoMount built-in (PRD 6.4)
CONFIG_NOMOUNT=y

## BBRv3 (backport WildKernels, scripts/bbrv3-510.patch). Kconfig patch mendefinisikan
## TCP_CONG_BBR3 dengan "default n", jadi tanpa baris ini tcp_bbr3.o tidak pernah
## dikompilasi dan bbr3 tidak muncul di tcp_available_congestion_control.
## Algoritma terdaftar dengan nama "bbr3" (bbr asli tetap ada). Default congestion
## control TIDAK diubah (tetap bawaan GKI); pilih lewat sysctl:
##   sysctl -w net.ipv4.tcp_congestion_control=bbr3
CONFIG_TCP_CONG_BBR3=y

## LTO thin (PRD 6.5). Folder arch/Kconfig pada base commit:
##   config LTO (629), LTO_CLANG (634), LTO_NONE (680),
##   LTO_CLANG_FULL (685), LTO_CLANG_THIN (704)
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_NONE is not set

## Modul vendor tetap mau dimuat walau suffix rilis berubah (PRD 6.1)
CONFIG_MODVERSIONS=y

## Nama kernel: uname -r jadi 5.10.274-Scarlet.
## Tanpa ini scripts/setlocalversion menempel "-g<12 hex commit>" (LOCALVERSION_AUTO=y,
## default init/Kconfig; gki_defconfig tidak mengubahnya). Akibatnya Linux version,
## uname -r, dan vermagic modul ikut berubah. MODVERSIONS=y (di bawah) membuat loader
## modul melewati bagian rilis saat membandingkan vermagic.
CONFIG_LOCALVERSION="-Scarlet"
# CONFIG_LOCALVERSION_AUTO is not set

## Scarlet gaming — governor CPU: hanya schedutil + scarlet (scarlet default).
## Governor lain dimatikan; performance tetap tersedia sebagai fallback core
## tapi tidak dipasang di scaling_available_governors.
CONFIG_CPU_FREQ_GOV_SCARLET=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCARLET=y
# CONFIG_CPU_FREQ_GOV_PERFORMANCE is not set
# CONFIG_CPU_FREQ_GOV_POWERSAVE is not set
# CONFIG_CPU_FREQ_GOV_USERSPACE is not set
# CONFIG_CPU_FREQ_GOV_ONDEMAND is not set
# CONFIG_CPU_FREQ_GOV_CONSERVATIVE is not set
# CONFIG_CPU_FREQ_GOV_SCHEDHORIZON is not set
# CONFIG_CPU_FREQ_GOV_REFLEX is not set

## Scarlet gaming — governor devfreq (GPU dll.): scarlet + simple_ondemand.
## simple_ondemand TIDAK bisa dimatikan: drivers/scsi/ufs/Kconfig mem-select-nya
## untuk scaling frekuensi storage UFS (select tidak bisa dioverride fragment).
## Governor lain yang diminta vendor tapi tidak ada di kernel akan di-fallback
## ke "scarlet" oleh drivers/devfreq/devfreq.c (patch scarlet-gaming),
## jadi perangkat GPU tidak pernah kehilangan governor, freq terkunci max.
CONFIG_DEVFREQ_GOV_SCARLET=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
# CONFIG_DEVFREQ_GOV_PERFORMANCE is not set
# CONFIG_DEVFREQ_GOV_POWERSAVE is not set
# CONFIG_DEVFREQ_GOV_USERSPACE is not set
# CONFIG_DEVFREQ_GOV_PASSIVE is not set

